# JITACM Event & Registration Platform - Environment Configuration Template
# Copy this file to .env and adjust as needed. NEVER commit .env to version control.

# --- Server Configuration ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- PostgreSQL Connection String ---
# For local Docker Compose:
DATABASE_URL=postgresql://jitacm_admin:jitacm_dev_password@localhost:5432/jitacm_events?sslmode=disable

# --- Redis Cache & Lock Store ---
REDIS_URL=redis://localhost:6379

# --- Security & JWT (Phase 3 placeholder) ---
JWT_SECRET=dev_jwt_secret_change_in_production_min_32_characters
QR_SIGNING_SECRET=dev_qr_hmac_secret_change_in_production
